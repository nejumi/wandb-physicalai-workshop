# Copy this file to .env and fill in your values.
# Then: source .env  (or use direnv)
#
# Alternatively, run `wandb login` once — credentials are saved to ~/.netrc
# and picked up automatically by both wandb and weave.

# --- W&B ---
WANDB_ENTITY=your-entity          # e.g. wandb-japan
WANDB_PROJECT=physical-ai-workshop
# WANDB_API_KEY=your-key           # only needed if you skip `wandb login`

# --- Weave (same API key as W&B) ---
# WEAVE_PROJECT is passed as a CLI flag in the scripts, not an env var.
# Nothing extra to set here if you have already done `wandb login`.

# --- HuggingFace (cache location) ---
# HF_HOME=/mnt/shared/.cache/huggingface

# --- Cluster ---
# ENV_PATH=/mnt/home/yourname/.mamba/envs/aimo3-art
